# API base URL baked into the production build (Vite reads this at build time).
# Public URL, not a secret. Used directly by native Capacitor builds (which have
# no dev-server proxy) and as the default for the web build. On Vercel, a
# dashboard env var of the same name overrides this if set.
VITE_API_URL=https://nametag.onrender.com/api
